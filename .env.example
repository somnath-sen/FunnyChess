# FunnyChess Environment Configuration (Free-First)
# To connect to your free Supabase project, populate these values in .env.local
# If left empty, FunnyChess will automatically run in zero-friction Guest / Local Demo Mode!

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Site URL for OAuth redirects and share links (defaults to current window.location.origin)
# In production on Vercel: https://funny-chess-sigma.vercel.app
NEXT_PUBLIC_SITE_URL=https://funny-chess-sigma.vercel.app

